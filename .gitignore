# agent / editor
.claude/*
!.claude/hooks/
!.claude/settings.json
.idea/
.vscode/
.mcp.json
/.env

# build artifacts (C + CMake + SDL2)
/build/
/build-*/
/out/
/.out/
*.o
*.obj
*.a
*.so
*.dylib
*.exe
compile_commands.json
.cache/

# generated headers + extracted data (never commit; rebuilt from the disassembly)
generated/
/include/generated/

# pret/poketcg disassembly: build-time input, cloned by `just bootstrap`. Both
# spellings: a jj workspace shares one .gitignore, and a workspace that reaches
# the clone through a symlink (`poketcg -> ../poketcg/poketcg`) sees a *file*,
# which `/poketcg/` does not match -- it showed up as `A poketcg` in `jj st`.
/poketcg
/poketcg/
*.gbc
*.sym
*.map

# runtime / cruft
imgui.ini
*.sav
__pycache__/
*.pyc
*.log
.DS_Store
saves/

# Oracle-generated environments and focused builds
/tools/oracle/.venv/
/tools/oracle/gbref/build/
.factory/*
!.factory/blocked.toml
.wrangler/
.cloudflare/
