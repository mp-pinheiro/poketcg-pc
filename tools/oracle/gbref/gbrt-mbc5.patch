diff --git a/src/gbrt.c b/src/gbrt.c
--- a/src/gbrt.c
+++ b/src/gbrt.c
@@ -2860,7 +2860,7 @@
         else if (ctx->mbc_type >= 0x19 && ctx->mbc_type <= 0x1E) {
             if (addr < 0x2000) {
                 /* RAM Enable */
-                ctx->ram_enabled = ((value & 0x0F) == 0x0A);
+                ctx->ram_enabled = (value == 0x0A);
             } else if (addr < 0x3000) {
                 /* ROM Bank Number (lower 8 bits) */
                 ctx->rom_bank_low = value;
@@ -2872,7 +2872,10 @@
                 ctx->rom_bank = gb_resolve_rom_bank(ctx, 0x4000);
             } else if (addr < 0x6000) {
                 /* RAM Bank Number (0-15) */
-                ctx->ram_bank = value & 0x0F;
+                const uint32_t physical_ram_banks = ctx->eram_size / 0x2000u;
+                ctx->ram_bank = physical_ram_banks == 0
+                    ? 0
+                    : (uint8_t)((value & 0x0F) % physical_ram_banks);
             }
             /* 0x6000-0x7FFF: Unused for MBC5 */
         }
diff --git a/include/gbrt.h b/include/gbrt.h
--- a/include/gbrt.h
+++ b/include/gbrt.h
@@ -334,2 +334,8 @@
     void* port_state; /**< Opaque optional native port/frontend state */
+    uint8_t oracle_post_call_byte;
+    uint8_t oracle_post_call_byte_valid;
+    uint8_t oracle_ir_peer;
+    uint16_t oracle_ir_writes;
+    uint16_t oracle_ir_reads;
+    uint8_t oracle_ir_rx_byte;
     GBHostConfigurationContract host_configuration_contract; /**< Host-only configuration validation service */
diff --git a/src/gbrt.c b/src/gbrt.c
--- a/src/gbrt.c
+++ b/src/gbrt.c
@@ -2670,3 +2670,5 @@
         if (addr >= 0xFEA0) {
+            if (addr == 0xFEA0 && ctx->oracle_post_call_byte_valid)
+                return ctx->oracle_post_call_byte;
             return 0xFF;
         }
@@ -2701,4 +2701,36 @@
         if (addr == 0xFF56) {
+            if (ctx->oracle_ir_peer) {
+                uint16_t sample_total = ctx->oracle_ir_reads++;
+                uint16_t byte_index = sample_total / 81u;
+                uint16_t sample = sample_total % 81u;
+                if (sample_total == 0u && ctx->oracle_ir_writes > 1u)
+                    ctx->oracle_ir_rx_byte = 1u;
+                uint8_t rx_byte;
+                if (ctx->oracle_ir_writes <= 1u) {
+                    rx_byte = byte_index == 0u ? 0xAAu
+                        : (byte_index == 1u ? 0x49u
+                           : (byte_index == 2u ? 0x52u : 0x00u));
+                } else if (byte_index == 0u) {
+                    rx_byte = 0x33u;
+                } else if (byte_index == 1u) {
+                    rx_byte = 0xAAu;
+                } else if (ctx->oracle_ir_rx_byte != 0x33u && byte_index == 2u) {
+                    rx_byte = 0x33u;
+                } else if (ctx->oracle_ir_rx_byte == 0x33u && byte_index == 2u) {
+                    rx_byte = 0x49u;
+                } else if (ctx->oracle_ir_rx_byte == 0x33u && byte_index == 3u) {
+                    rx_byte = 0x52u;
+                } else if (ctx->oracle_ir_rx_byte == 0x33u && byte_index == 12u) {
+                    rx_byte = 0x01u;
+                } else {
+                    rx_byte = 0x00u;
+                }
+                if (sample == 0u) return 0x3C;
+                uint16_t bit = (uint16_t)((sample - 1u) / 10u);
+                if (bit < 8u)
+                    return (rx_byte & (uint8_t)(1u << bit)) ? 0x3E : 0x3C;
+                return 0x3C;
+            }
             if (!gb_is_cgb_mode(ctx)) return 0xFF;
             return 0x3E;
         }
diff --git a/src/gbrt.c b/src/gbrt.c
--- a/src/gbrt.c
+++ b/src/gbrt.c
@@ -3057,6 +3057,8 @@
         if (addr == 0xFF56) {
             if (gb_is_cgb_mode(ctx)) {
                 ctx->io[0x56] = (value & 0xC1) | 0x3E;
+                if (ctx->oracle_ir_peer)
+                    ctx->oracle_ir_writes++;
             }
             return;
         }
