#!/bin/sh
# Non-interactive Forgejo credentials for git and jj.
#
# Configured host-scoped (see docs/jj-workflow.md):
#   git config --global credential.https://forgejo.yfrit.com.helper \
#     /home/matheus/git/poketcg/tools/git-credential-forgejo
#
# Reads the same PAT as tools/factory/forgejo.py so rotation touches one file.
set -eu

[ "${1:-}" = get ] || exit 0

host=""
while IFS= read -r line; do
    case "$line" in
        host=*) host=${line#host=} ;;
        "") break ;;
    esac
done

expected_host="${POKETCG_FORGEJO_HOST:-forgejo.yfrit.com}"
[ "$host" = "$expected_host" ] || exit 0

token="${POKETCG_FORGEJO_TOKEN:-}"
if [ -z "$token" ]; then
    token_file="${POKETCG_FORGEJO_TOKEN_FILE:-$HOME/.config/yfrit-forgejo/api/poketcg-issues.token}"
    if [ ! -r "$token_file" ]; then
        echo "git-credential-forgejo: no token in POKETCG_FORGEJO_TOKEN or $token_file" >&2
        exit 1
    fi
    token=$(cat "$token_file")
fi

# Accept the same shapes as forgejo.py forgejo_authorization().
token=${token#Authorization:}
token=${token# }
case "$token" in
    "token "*|"Token "*|"bearer "*|"Bearer "*) token=${token#* } ;;
esac
token=$(printf '%s' "$token" | tr -d ' \t\r\n')
if [ -z "$token" ]; then
    echo "git-credential-forgejo: resolved token is empty" >&2
    exit 1
fi

printf 'username=%s\npassword=%s\n' "${POKETCG_FORGEJO_USER:-mpp}" "$token"
